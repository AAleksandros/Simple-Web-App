# Copy to backend/.env and fill in. Read by Django (backend/settings.py) and by
# the Postgres container (docker-compose.yml).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=webapp
POSTGRES_USER=webapp
POSTGRES_PASSWORD=change-me
# "db" inside docker compose; use localhost when running Django on the host.
DB_HOST=db
DB_PORT=5432

# Origin(s) of the Vue dev server or deployed frontend, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

AZURE_EMAIL_CONNECTION_STRING=
AZURE_SENDER_EMAIL=
